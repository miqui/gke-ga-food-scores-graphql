# Local development only; copy to .env. Never commit real credentials.
DATABASE_URL=postgresql://gafood:gafood@localhost:5432/gafood
# Comma-separated counties for `npm run sync` (default: all 159). Multi-word names allowed: BEN HILL
SYNC_COUNTIES=LONG
PORT=4000
# OTLP/HTTP collector base URL; sync metrics are pushed to <endpoint>/v1/metrics
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
